{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drawspell",
  "workers_dev": true,
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "VITE_ENV": "development",
    "AUTH_URL": "https://ds.localhost",
    "EMAIL_FROM": "support@drawspell.space",
  },
  // IDs are omitted intentionally: Wrangler provisions missing bindings on deployment.
  // For a controlled rollout, create each database and set its ID before applying migrations.
  "d1_databases": [{ "binding": "DB", "database_name": "drawspell-developers-local", "migrations_dir": "migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "services": [{ "binding": "SERVER", "service": "drawspell-server" }],
  "env": {
    "staging": {
      "name": "drawspell-web-staging",
      "d1_databases": [{ "binding": "DB", "database_name": "drawspell-developers-staging", "migrations_dir": "migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "services": [{ "binding": "SERVER", "service": "drawspell-server-staging" }],
      "vars": {
        "VITE_ENV": "staging",
        "AUTH_URL": "https://staging.drawspell.space",
        "EMAIL_FROM": "support@drawspell.space",
      },
      "routes": [
        {
          "pattern": "staging.drawspell.space",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "name": "drawspell-web-production",
      "d1_databases": [{ "binding": "DB", "database_name": "drawspell-developers-production", "database_id": "92e58273-8e41-4653-b2c8-7cbca9d3a948", "migrations_dir": "migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "services": [{ "binding": "SERVER", "service": "drawspell-server-production" }],
      "vars": {
        "VITE_ENV": "production",
        "AUTH_URL": "https://drawspell.space",
        "EMAIL_FROM": "support@drawspell.space",
      },
      "routes": [
        {
          "pattern": "drawspell.space",
          "custom_domain": true,
        },
      ],
    },
  },
}
